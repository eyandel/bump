<?xml version="1.0" ?>

<!-- this is always "nu"-->
<mode name="nu" />

<!-- the detector we're using is always "uBooNE" -->
<!-- the POT will be what to normalize to, this will almost always be the total data POT -->
<detector name="uBooNE" pot="4.031e19" />

<!--channel is the selection name. subchannels should be one per kind of events that need to be considered spearately in the covariance. Will usually be one per kind of file (except data).-->
<!--plotname determines plot title-->
<!--unit names the x-axis of the plot (what the plotted variable is)-->
<!--min, max, nbins sets the binning for that variable-->
<channel name="selection" plotname="Variable Name [unit]">
	<bins unit="Variable Name [unit]" min="0" max="2500" nbins="25"/>
	<subchannel name="ext" plotname="Ext" color="#676a67"/>
	<subchannel name="dirt" plotname="Dirt" color="#895129"/>
	<subchannel name="overlay" plotname="#nu_{#mu}CC Other" color="#21B1FF"/>
</channel>

<!--this is not an oscillation so model should always be "nullmodel"-->
<model tag="nullmodel">
    <rule index="0" name="No Osc"/>
</model>

<!--filename is full path to the root ntuple file -->
<!-- for multiple runs will need multiple ~identical blocks like this for each of the runs with the different files-->
<!--model rule for overlays/MC is 1. For data/ext it is 0-->
<!--weight_1 has the selection-->
<!--weight_2 has the actual weights. For MC/overlay these are weight_cv and weight_spline with checks for bad values. For data/ext there are usually no weights.-->
<MCFile treename="wcpselection/T_KINEvars" filename="/Users/eyandel/Documents/MicroBooNE/processed_checkout_rootfiles/splines/checkout_run4b_nu_overlay_retuple_splines.root" pot="6.7583e20" partial_load_frac="1.0">
	<friend treename="wcpselection/T_eval" />
	<friend treename="wcpselection/T_PFeval" />
	<friend treename="wcpselection/T_BDTvars" />
	<friend treename="spline_weights" />
	<friend treename="nuselection/NeutrinoSelectionFilter" />
    <friend treename="singlephotonana/vertex_tree"/>
    <friend treename="lantern/EventTree"/>
	<branch
        	associated_subchannel = "nu_uBooNE_selection_overlay"
        	model_rule            = "1"
			weight_1              = "((0 < kine_reco_Enu) && (shw_sp_n_20mev_showers > 0) && (reco_nuvtxX>5.0 && reco_nuvtxX<250.0) && (single_photon_numu_score < 0.1) && (single_photon_numu_score > -20.0) && (Sum$(abs(kine_particle_type)==2212 && kine_energy_particle>35) > 0))"
			weight_2              = "(weight_cv * weight_spline * (weight_cv * weight_spline < 30) * (weight_cv * weight_spline > 0) + 1 * !((weight_cv * weight_spline < 30) * (weight_cv * weight_spline > 0)))"
		>
		<variable>kine_reco_Enu</variable>
	</branch>

</MCFile>

